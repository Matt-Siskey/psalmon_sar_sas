spawngr_recover_df <-spawngr_recover_name %>% map_df(., ~as.data.frame(.)) %>%
rename("recovery_location_code" = location_code) %>%
left_join(., spawngr_recover_sum, by="recovery_location_code") %>%
arrange(desc(number_cwt_estimated))
